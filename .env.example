SERVICE_SUPABASESERVICE_KEY=
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@example.com
EVENTPULSE_CRON_SECRET=
EVENTPULSE_PUBLIC_URL=
EVENTPULSE_SCHEDULER_ENABLED=false
EVENTPULSE_SCHEDULER_TICK_MS=1000
# Minimum seconds between two ticket-page loads through the same Multilogin profile.
EVENTPULSE_PROFILE_MIN_INTERVAL_SECONDS=60
# /api/eventpulse/health reports monitor "degraded" when no active target had a clean check for this long.
EVENTPULSE_HEALTH_STALE_MINUTES=30
# Operator-only Discord-compatible webhooks for operational notices (never the client's ticket channels).
EVENTPULSE_OPS_WEBHOOK_URLS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_SMS_TO=+447000000000,+447000000001
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TO=whatsapp:+447000000000,whatsapp:+447000000001
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
DISCORD_WEBHOOK_URLS=
MULTILOGIN_API_TOKEN=
MULTILOGIN_TOKEN_EXPIRY_WARNING_HOURS=72
MULTILOGIN_LAUNCHER_ENDPOINT=
MULTILOGIN_CDP_HOST=host.docker.internal
MULTILOGIN_HEADLESS=false
MULTILOGIN_PROXY_CREDENTIALS={}
MULTILOGIN_SCRAPER_PROXIES=[]
# Browser for temporary quick profiles: stealthfox (default, runs on the Linux launcher container)
# or mimic (needs a desktop Multilogin agent).
MULTILOGIN_QUICK_BROWSER=stealthfox
